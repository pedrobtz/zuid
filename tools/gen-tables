#!/usr/bin/env Rscript
# Regenerate zuid's generated tables from their pinned upstream sources.
#
#   tools/gen-tables            download, verify and write
#   tools/gen-tables --check    verify only; exit 1 if a written file differs
#
# Run from the package root. Needs R >= 4.5 (tools::sha256sum) and the yaml
# package; neither is a package dependency, because this is maintainer
# tooling. design.md D8.
#
# Writes:
#   R/sysdata.rda         niceware_words, sqids_blocklist, table_sources
#   src/zuid_tables.h     counts and extern declarations
#   src/zuid_tables.c     the same tables as C arrays

args <- commandArgs(trailingOnly = TRUE)
check_only <- "--check" %in% args

if (!file.exists("DESCRIPTION") || !file.exists("tools/fixture-sources.yaml")) {
  stop("run tools/gen-tables from the package root", call. = FALSE)
}

sources <- yaml::read_yaml("tools/fixture-sources.yaml")$tables

fetch <- function(src) {
  url <- sprintf(
    "https://raw.githubusercontent.com/%s/%s/%s",
    src$repo, src$commit, src$path
  )
  path <- tempfile()
  utils::download.file(url, path, quiet = TRUE, mode = "wb")
  sha <- unname(tools::sha256sum(path))
  if (!identical(sha, src$sha256)) {
    stop(sprintf("%s: SHA-256 is %s, expected %s", url, sha, src$sha256),
         call. = FALSE)
  }
  path
}

parse_table <- function(path, format) {
  text <- readLines(path, warn = FALSE, encoding = "UTF-8")
  words <- switch(format,
    # A JSON array of strings, all on one line.
    json = {
      body <- paste(text, collapse = "")
      regmatches(body, gregexpr('"[^"]*"', body))[[1]]
    },
    # One quoted word per line inside `module.exports = [ ... ];`.
    "js-array" = grep("^'[^']*',?$", trimws(text), value = TRUE),
    stop("unknown table format: ", format, call. = FALSE)
  )
  gsub("^['\"]|['\"],?$", "", words)
}

tables <- lapply(names(sources), function(name) {
  src <- sources[[name]]
  words <- parse_table(fetch(src), src$format)
  if (length(words) != src$entries) {
    stop(sprintf("%s: %d entries, expected %d", name, length(words),
                 src$entries), call. = FALSE)
  }
  if (!all(grepl("^[a-z0-9]+$", words))) {
    stop(name, ": entries outside [a-z0-9]", call. = FALSE)
  }
  words
})
names(tables) <- names(sources)

niceware_words <- tables$niceware_words
sqids_blocklist <- tables$sqids_blocklist
if (is.unsorted(niceware_words, strictly = TRUE)) {
  # Niceware maps a 16-bit index to a word and back by binary search.
  stop("niceware_words is not strictly sorted", call. = FALSE)
}

table_sources <- data.frame(
  table = names(sources),
  repo = vapply(sources, `[[`, "", "repo"),
  commit = vapply(sources, `[[`, "", "commit"),
  path = vapply(sources, `[[`, "", "path"),
  sha256 = vapply(sources, `[[`, "", "sha256"),
  entries = vapply(sources, function(s) as.integer(s$entries), 0L),
  row.names = NULL,
  stringsAsFactors = FALSE
)

c_array <- function(name, words) {
  c(
    sprintf("const char *const %s[%d] = {", name, length(words)),
    paste0("    \"", words, "\","),
    "};"
  )
}

header <- c(
  "/* Generated by tools/gen-tables from tools/fixture-sources.yaml.",
  " * Do not edit by hand. design.md D8. */",
  "#ifndef ZUID_TABLES_H",
  "#define ZUID_TABLES_H",
  "",
  sprintf("#define ZUID_NICEWARE_N %d", length(niceware_words)),
  sprintf("#define ZUID_SQIDS_BLOCKLIST_N %d", length(sqids_blocklist)),
  "",
  "/* Niceware 4.0.0: index i is the word for the 16-bit value i. Sorted. */",
  "extern const char *const zuid_niceware_words[ZUID_NICEWARE_N];",
  "/* The Sqids blocklist, lowercase, in upstream order. */",
  "extern const char *const zuid_sqids_blocklist[ZUID_SQIDS_BLOCKLIST_N];",
  "",
  "#endif"
)

source_c <- c(
  "/* Generated by tools/gen-tables from tools/fixture-sources.yaml.",
  " * Do not edit by hand. design.md D8. */",
  "#include \"zuid_tables.h\"",
  "",
  sprintf("/* %s@%s %s */", sources$niceware_words$repo,
          sources$niceware_words$commit, sources$niceware_words$path),
  c_array("zuid_niceware_words", niceware_words),
  "",
  sprintf("/* %s@%s %s */", sources$sqids_blocklist$repo,
          sources$sqids_blocklist$commit, sources$sqids_blocklist$path),
  c_array("zuid_sqids_blocklist", sqids_blocklist)
)

outputs <- list(
  "src/zuid_tables.h" = header,
  "src/zuid_tables.c" = source_c
)

sysdata_new <- tempfile(fileext = ".rda")
save(niceware_words, sqids_blocklist, table_sources,
     file = sysdata_new, compress = "xz", version = 3)

if (check_only) {
  stale <- character()
  for (path in names(outputs)) {
    if (!file.exists(path) || !identical(readLines(path), outputs[[path]])) {
      stale <- c(stale, path)
    }
  }
  old <- new.env()
  new <- new.env()
  if (file.exists("R/sysdata.rda")) load("R/sysdata.rda", envir = old)
  load(sysdata_new, envir = new)
  for (obj in ls(new)) {
    if (!identical(old[[obj]], new[[obj]])) {
      stale <- c(stale, paste0("R/sysdata.rda:", obj))
    }
  }
  if (length(stale)) {
    message("stale: ", paste(stale, collapse = ", "))
    quit(status = 1)
  }
  message("tables up to date")
} else {
  for (path in names(outputs)) writeLines(outputs[[path]], path)
  file.copy(sysdata_new, "R/sysdata.rda", overwrite = TRUE)
  message("wrote ", paste(c(names(outputs), "R/sysdata.rda"), collapse = ", "))
}
