#!/usr/bin/env python3
"""Write tests/testthat/fixtures/encodings.csv from the Python reference
libraries (design.md section 7, oracles 2, 10 and 11; section 15 Q2), and
tests/testthat/fixtures/{upid,scru128,scru64}.csv from the UPID, SCRU128 and
SCRU64 Python references (oracle 5).

Each row is a form, the bytes in hex, and the text the reference library
writes for them. zuid follows what mainstream Go and Python libraries emit
(2026-10-24); the Go libraries were checked to agree where both exist.

Run it in a virtual environment holding exactly the versions pinned in
tools/fixture-sources.yaml (fixtures: encodings):

    python3 -m venv /tmp/zuid-enc && /tmp/zuid-enc/bin/pip install \
      base58==2.1.1 pybase62==1.0.0 python-ulid==4.0.1 uuid25==0.1.4 \
      base32-crockford==0.3.0 shortuuid==1.0.13 proquint==0.2.1 upid==0.3.1 \
      scru128==3.0.4 scru64==1.0.2
    (cd /tmp/zuid-enc && npm install --ignore-scripts niceware@4.0.0)
    NICEWARE_JS=/tmp/zuid-enc/node_modules/niceware \
      /tmp/zuid-enc/bin/python -I tools/gen-fixtures

Niceware comes from the JavaScript reference, 4.0.0, whose word list zuid
ships. Python's niceware 0.2.1 has an older list and does not interoperate.
"""

import base64
import csv
import json
import os
import subprocess
import random
import sys
import uuid

import base32_crockford
import base58
import base62
import proquint
import shortuuid
import shortuuid.main
import scru128
import scru64
import ulid
import upid
import uuid25

OUT = "tests/testthat/fixtures/encodings.csv"
OUT_UPID = "tests/testthat/fixtures/upid.csv"

SPECIAL = [
    "f81d4fae7dec11d0a76500a0c91e6bf6",  # RFC 9562 section 4
    "00000000000000000000000000000001",
    "00000000000000000000000000000000",
    "ffffffffffffffffffffffffffffffff",
]

B64_STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
# draft-davis-uuidrev-alt-uuid-encoding-methods: base64url's grouping in an
# alphabet in ASCII order. No Go or Python library implements it.
B64_SORT = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"
SHORTUUID = shortuuid.ShortUUID().get_alphabet()


def width(n, base):
    """Digits for n bytes in a base: the smallest d with base**d >= 256**n."""
    d = 0
    while base**d < 256**n:
        d += 1
    return d


def pad(text, n, base, zero):
    return text.rjust(width(n, base), zero)


def crockford(b):
    if len(b) == 16:
        return str(ulid.ULID.from_bytes(b))
    if not b:
        return ""
    return pad(base32_crockford.encode(int.from_bytes(b, "big")), len(b), 32, "0")


def base36(b):
    if len(b) == 16:
        return uuid25.Uuid25.from_bytes(b).value
    v, digits = int.from_bytes(b, "big"), ""
    while v:
        v, r = divmod(v, 36)
        digits = "0123456789abcdefghijklmnopqrstuvwxyz"[r] + digits
    return pad(digits, len(b), 36, "0")


def alphabet(b):
    if len(b) == 16:
        return shortuuid.ShortUUID().encode(uuid.UUID(bytes=b))
    return shortuuid.main.int_to_string(
        int.from_bytes(b, "big"), list(SHORTUUID), padding=width(len(b), 57)
    )


def b62(b):
    v = int.from_bytes(b, "big")
    return pad(base62.encode(v) if v else "", len(b), 62, "0")


FORMS = {
    "hex": lambda b: b.hex(),
    "base32": crockford,
    "base32rfc": lambda b: base64.b32encode(b).decode().rstrip("="),
    "base32hex": lambda b: base64.b32hexencode(b).decode().rstrip("="),
    "base36": base36,
    "base58": lambda b: base58.b58encode(b).decode(),
    "base62": b62,
    "base64url": lambda b: base64.urlsafe_b64encode(b).decode().rstrip("="),
    "base64sort": lambda b: base64.urlsafe_b64encode(b)
    .decode()
    .rstrip("=")
    .translate(str.maketrans(B64_STD, B64_SORT)),
    "alphabet": alphabet,
    "proquint": lambda b: "-".join(
        proquint.uint2quint(int.from_bytes(b[i : i + 2], "big"))[6:]
        for i in range(0, len(b), 2)
    ),
    "words": None,  # niceware_js(), in one call
}
EVEN_ONLY = {"proquint", "words"}


def niceware_js(blobs):
    script = (
        "const n = require(process.argv[1]);"
        "const xs = JSON.parse(require('fs').readFileSync(0, 'utf8'));"
        "console.log(JSON.stringify(xs.map(h =>"
        " n.bytesToPassphrase(Buffer.from(h, 'hex')).join('-'))));"
    )
    run = subprocess.run(
        ["node", "-e", script, os.environ["NICEWARE_JS"]],
        input=json.dumps([b.hex() for b in blobs]),
        capture_output=True,
        text=True,
        check=True,
    )
    return json.loads(run.stdout)


def inputs(form):
    rng = random.Random(20261024)
    out = [bytes.fromhex(h) for h in SPECIAL]
    out += [rng.randbytes(16) for _ in range(40)]
    # Leading zero bytes matter to base58 and to the fixed widths.
    out += [bytes(k) + rng.randbytes(16 - k) for k in range(1, 16)]
    out += [rng.randbytes(n) for n in range(0, 41)]
    out += [rng.randbytes(n) for n in (64, 100, 255)]
    if form in EVEN_ONLY:
        out = [b for b in out if len(b) % 2 == 0]
    return out


def main():
    with open(OUT, "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["form", "hex", "text"])
        for form, enc in FORMS.items():
            blobs = inputs(form)
            texts = niceware_js(blobs) if enc is None else map(enc, blobs)
            for b, t in zip(blobs, texts):
                w.writerow([form, b.hex(), t])
    print(f"wrote {OUT}", file=sys.stderr)

    # UPID: the reference's text for random bytes, every version nibble.
    rng = random.Random(20261025)
    blobs = [bytes.fromhex(h) for h in SPECIAL] + [rng.randbytes(16) for _ in range(200)]
    with open(OUT_UPID, "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["hex", "text", "prefix", "milliseconds"])
        for b in blobs:
            u = upid.UPID(b)
            w.writerow([b.hex(), u.to_str(), u.prefix, u.milliseconds])
    print(f"wrote {OUT_UPID}", file=sys.stderr)

    # SCRU128: the reference's text and fields for random values and the
    # field boundaries of its own tests.
    m48, m24, m32 = 2**48 - 1, 2**24 - 1, 2**32 - 1
    fields = [(0, 0, 0, 0), (m48, 0, 0, 0), (0, m24, 0, 0), (0, 0, m24, 0),
              (0, 0, 0, m32), (m48, m24, m24, m32), (1, 0, 0, 0)]
    rng = random.Random(20261026)
    fields += [(rng.randrange(1, m48), rng.randrange(m24 + 1),
                rng.randrange(m24 + 1), rng.randrange(m32 + 1))
               for _ in range(200)]
    with open("tests/testthat/fixtures/scru128.csv", "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["hex", "text", "timestamp", "counter_hi", "counter_lo", "entropy"])
        for t in fields:
            x = scru128.Scru128Id.from_fields(*t)
            w.writerow([int(x).to_bytes(16, "big").hex(), str(x), *t])

    # SCRU64: the reference's text, timestamp and node_ctr for random values
    # below 36^12 and the boundaries.
    top = 36**12 - 1
    nums = [0, 2**24 - 1, top, top >> 24 << 24, 1 << 24, 109959589539758421]
    nums += [rng.randrange(top + 1) for _ in range(200)]
    with open("tests/testthat/fixtures/scru64.csv", "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["hex", "text", "timestamp", "node_ctr"])
        for v in nums:
            x = scru64.Scru64Id(v)
            w.writerow([v.to_bytes(8, "big").hex(), str(x), x.timestamp, x.node_ctr])
    print("wrote scru128.csv and scru64.csv", file=sys.stderr)


if __name__ == "__main__":
    main()
